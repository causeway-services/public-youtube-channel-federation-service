[Unit]
Description=Authenticate and admit the completed five-channel daily portfolio snapshot
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/emsenn/info/lib/emsenn/services/561-group/services/public-services-section/services/public-computer-services-section/services/public-web-services-section/services/public-web2-services-section/services/public-youtube-services-section/services/public-youtube-channel-federation-service
